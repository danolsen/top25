{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "db",
      "type": "shell",
      "command": "docker compose up -d db mailpit",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "frontend-dev",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "prep-debug",
      "dependsOn": ["db", "frontend-dev"],
      "dependsOrder": "parallel"
    }
  ]
}
